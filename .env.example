# Copy to .env and adjust for your environment
SECRET_KEY=replace-with-a-generated-64-character-secret
DATABASE=karaoke.db
# Production: prefer DATABASE_URL over DATABASE.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
TAX_RATE=0.055
LOG_LEVEL=INFO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
STAFF_USERNAME=staff
STAFF_PASSWORD=replace-with-a-strong-staff-password
FLASK_APP=app.py
# APP_ENV=production
# SESSION_COOKIE_SECURE=true
# FLASK_DEBUG=true

# Google OAuth 2.0 configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP Mail configuration (e.g. Gmail SMTP)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=your-email@gmail.com
MAIL_SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# Reservation Operations config
STAFF_NOTIFY_EMAIL=staff-alerts@example.com
CANCEL_CUTOFF_HOURS=2
BASE_URL=http://localhost:5000

